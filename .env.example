# ── North Alpha — environment configuration ─────────────────────────────
# Copy this file to `.env.local` and fill in the values. Everything works
# without these (placeholders/fallbacks kick in), but set them for production.

# Booking link (Cal.com or Calendly). Until set, the booking areas show a
# clearly-marked placeholder with an email fallback. Paste your public link,
# e.g. https://cal.com/davidbunn/discovery or https://calendly.com/davidbunn/30min
NEXT_PUBLIC_BOOKING_URL=

# Where contact-form submissions are emailed.
OWNER_EMAIL=davibunn@gmail.com

# Resend API key (https://resend.com). When set, the contact form sends real
# email. When empty, submissions are logged server-side and the form still
# shows its success state (so it's testable before you sign up).
RESEND_API_KEY=

# Verified "from" sender for Resend. For quick testing you can use Resend's
# onboarding domain; for production use an address on a domain you've verified
# in Resend, e.g. hello@northalpha.ai
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Public LinkedIn URL (footer + JSON-LD).
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/davidkcbunn

# Canonical site URL (used for metadata, sitemap, robots, OG image).
NEXT_PUBLIC_SITE_URL=https://northalpha.ai
