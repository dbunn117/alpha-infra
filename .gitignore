# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# internal planning docs (build spec, copy deck) — kept out of the public repo
/docs/

# personal documents & private planning that may sit in the project folder —
# never publish these to the public repo
/*.pdf
/*.docx
/*.zip
/Basic_LinkedInDataExport_*
/first-clients-strategy.md
/fable5-business-builder-prompt.md
/north-alpha-TAM-analysis.md
/upwork-30-day-plan.md
/Professional Photos*/

# old North Alpha brand assets — kept locally, not published post-rebrand
/brand/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
